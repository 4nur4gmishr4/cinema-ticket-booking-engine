# ==========================================
# Cinema Booking Engine - Environment Config
# ==========================================

# -----------------
# Backend Settings
# -----------------
PROJECT_NAME="Yozigo Cinema API"
VERSION="1.0.0"
API_V1_STR="/api/v1"

# Database Configuration:
# Default SQLite local database:
DATABASE_URL=sqlite:///./cinema.db
# For production PostgreSQL (e.g. Render, Railway, Supabase):
# DATABASE_URL=postgresql://user:password@hostname:5432/dbname

# JWT Authentication Secret Key:
SECRET_KEY=cinema-super-secret-jwt-key-2026-intern-assign
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Seat Hold Business Rules:
SEAT_HOLD_DURATION_SECONDS=300
MAX_SEATS_PER_BOOKING=6

# ------------------
# Frontend Settings
# ------------------
# Leave empty for local development (uses Vite proxy /api -> http://127.0.0.1:8001)
# For production deployments where frontend is hosted on separate domain (e.g. Vercel/Netlify):
# VITE_API_BASE_URL=https://your-backend-api.onrender.com
VITE_API_BASE_URL=
